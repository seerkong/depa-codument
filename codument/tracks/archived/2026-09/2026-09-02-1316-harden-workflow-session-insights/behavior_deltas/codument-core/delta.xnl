<BehaviorPatch #track.harden-workflow-session-insights.behavior_patch.codument-core apiVersion="codument.tech/v1alpha1" version="1" { capability = "codument-core" } (
  <Mutations [
    <Upsert { selector = "behavior://codument-core/requirements/scope-drift-reconciliation" } (
      <Requirement #scope-drift-reconciliation (
        <Statement ?>实现类 operation SHALL 从验收与工程事实推导预期改动面，并把 drift 分为可继续的目标内变化、需要协调的 authority 变化和真实决策或权限阻塞；scope drift 本身不得成为 mission 的隐式返回点。</?>
        <Suites [
          <Suite #scope-drift-rules { name = "Scope drift reconciliation" } (
            <Cases [
              <Case #local-drift-continues (
                <Given ?>任务发现目标内、局部且可逆的预期外工作</?>
                <When ?>执行器确认它仍服务于当前 Acceptance</?>
                <Then ?>执行器 SHALL 记录原因、更新预期改动面并继续，而不是暂停询问</?>
              )>
              <Case #authority-drift-reconciles (
                <Given ?>现有计划或 authority 假设被工程事实否定</?>
                <When ?>受影响范围可界定</?>
                <Then ?>执行器 SHALL 读取受影响真源、修订计划并验证后继续</?>
              )>
              <Case #only-real-blockers-return (
                <Given ?>当前工作需要新产品决策、不可逆外部动作、缺失权限或输入</?>
                <When ?>不存在保守默认或其他 ready 分支</?>
                <Then ?>系统 SHALL 使用 HumanConfirm 或真实 BLOCKED 返回</?>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/validator-rules-consistency/suites/mission-validation/cases/mission-node-status-enum" } (
      <Case #mission-node-status-enum (
        <Given ?>一个 mission.xml 或 mission.xnl 的 TaskGroup/Task 带有 status 属性</?>
        <When ?>系统校验该 Mission authority</?>
        <Then ?>系统 SHALL accept only NOT_STARTED, ACTIVE, DONE, BLOCKED, ABANDONED, SUPERSEDED</?>
        <Ands [
          <And ?>系统 SHALL report any other value, including the legacy misspelling SUPERSED, as an error with a stable rule id</?>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/rollback-review-event" } (
      <Requirement #rollback-review-event (
        <Statement ?>实现器 SHALL 仅在错误假设导致 agent 实现尝试被丢弃且教训可复用时执行简短 rollback review；它不是 Operation、hook 或停止条件。</?>
        <Suites [
          <Suite #rollback-review-rules { name = "Rollback review event" } (
            <Cases [
              <Case #qualified-trigger (
                <Given ?>agent 的实现尝试因反证被丢弃</?>
                <When ?>根因、正确路径或预防措施对后续有复用价值</?>
                <Then ?>实现器 SHALL 记录原假设与反证、根因与正确路径、预防措施，并继续当前控制循环</?>
              )>
              <Case #routine-operations-excluded (
                <Given ?>发生普通 rebase、branch switch、用户要求的恢复、生成物清理或无语义试验撤销</?>
                <When ?>没有可复用的错误假设</?>
                <Then ?>系统 SHALL NOT 触发 rollback review 或创建候选文件</?>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/attractor-check-protocol" } (
      <Requirement #attractor-check-protocol (
        <Statement ?>AttractorCheck SHALL 使用统一 fresh 只读协议返回 PASS、GAP 或 BLOCKED，由调用方负责差距修复、fresh 续轮和所属 track/mission 的控制流。</?>
        <Suites [
          <Suite #attractor-check-rules { name = "AttractorCheck protocol" } (
            <Cases [
              <Case #compact-verdict (
                <Given ?>显式 AttractorCheck hook 被调用</?>
                <When ?>fresh reviewer 完成只读方向审查</?>
                <Then ?>reviewer SHALL 返回 status、summary 和 evidence，status 仅为 PASS、GAP 或 BLOCKED</?>
              )>
              <Case #caller-owned-rounds (
                <Given ?>reviewer 返回 GAP</?>
                <When ?>调用方消费结果</?>
                <Then ?>调用方 SHALL 修复差距并启动新的 fresh reviewer；reviewer 不修改文件，也不把结果直接外推为 mission 返回</?>
              )>
              <Case #reference-closure (
                <Given ?>operation 直接创建或执行 AttractorCheck</?>
                <When ?>该 operation 文档被校验</?>
                <Then ?>文档 SHALL 引用 std/protocols/attractor-check.md，且不复制另一套 verdict 或轮次协议</?>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/pre-archive-retrospective" } (
      <Requirement #pre-archive-retrospective (
        <Statement ?>archive-track SHALL 在 strict validate 与 CLI archive transaction 之前完成 track-local retrospective，并物化确认合格的 decision/memory 候选；归档后不得修改 archive authority。</?>
        <Suites [
          <Suite #archive-order-rules { name = "Pre-archive retrospective" } (
            <Cases [
              <Case #retrospective-before-transaction (
                <Given ?>Track 准备归档</?>
                <When ?>archive operation 编排主流程</?>
                <Then ?>系统 SHALL 先运行 before hook、写 retrospective、物化候选，再 validate 和 archive</?>
              )>
              <Case #no-post-archive-authoring (
                <Given ?>CLI archive 已成功移动 Track 并提交 registry transaction</?>
                <When ?>执行 after hook 和最终报告</?>
                <Then ?>系统 SHALL 接受 CLI receipt 且不得再写已归档 authority</?>
              )>
            ]>
          )>
        ]>
      )>
    )>
    <Upsert { selector = "behavior://codument-core/requirements/continuation-checkpoint-authority" } (
      <Requirement #continuation-checkpoint-authority (
        <Statement ?>长 mission SHALL 仅在合法 invocation 返回或真实 handoff 时写紧凑 continuation checkpoint，并从 XNL、CLI 状态和最新 checkpoint 恢复，不依赖 token 百分比或 chat history。</?>
        <Suites [
          <Suite #continuation-rules { name = "Continuation checkpoint" } (
            <Cases [
              <Case #legal-boundary-only (
                <Given ?>mission 尚未命中 HumanConfirm、BLOCKED、终态、十 track checkpoint 或真实 handoff</?>
                <When ?>一个 task、track、回退事件或重规划完成</?>
                <Then ?>系统 SHALL 继续控制循环且 SHALL NOT 因上下文预算创建返回点</?>
              )>
              <Case #compact-resume-state (
                <Given ?>mission 在合法边界返回后恢复</?>
                <When ?>执行器重建 actual state</?>
                <Then ?>系统 SHALL 读取 mission/track XNL、CLI ready/status 和最新 checkpoint 中的目标、完成项、下一步、阻塞与证据</?>
              )>
            ]>
          )>
        ]>
      )>
    )>
  ]>
)>
