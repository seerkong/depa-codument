{
  "name": "depa-codument",
  "version": "0.6.0",
  "description": "DEPA-oriented Codument workflow tool for AI coding assistants",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run packages/cli/src/cli/index.ts",
    "build": "bun run scripts/build.ts",
    "pack:native": "bun run scripts/prepare-native-release.ts",
    "build:release": "bun run scripts/build-release.ts",
    "build:release:arm64": "bun run scripts/build-release.ts --arch=arm64",
    "build:release:x64": "bun run scripts/build-release.ts --arch=x64",
    "build:release:windows-x64": "bun run scripts/build-release.ts --target=windows-x64",
    "check:release": "bun run scripts/check-release.ts",
    "verify:xnl-integration": "bun run scripts/verify-xnl-bundle-integration.ts",
    "verify:mission": "bun run scripts/verify-mission.ts",
    "test": "bun run scripts/test.ts packages e2e",
    "test:cli": "bun run scripts/test.ts packages/cli/test/cli",
    "test:e2e:harness": "bun test e2e",
    "test:e2e": "bun e2e/run.ts",
    "lint": "bunx eslint packages scripts e2e",
    "typecheck": "bunx tsc --noEmit",
    "check": "bun run typecheck && bun run lint && bun run test",
    "benchmark:browser-backends": "bun run scripts/benchmark-browser-backends.ts",
    "benchmark:vue-pages": "bun run scripts/benchmark-vue-pages.ts",
    "page:stage": "bun run scripts/stage-workspace-page.ts",
    "install:local": "bun run scripts/install-local-release.ts",
    "clone": "bun run scripts/clone.ts"
  },
  "dependencies": {
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "halfcode-lite-page-builder-vue-support": "0.2.1",
    "depa-codument-domain-logic": "workspace:*",
    "halfcode-lite-cli-contract": "0.2.1",
    "halfcode-lite-cli-logic": "0.2.1",
    "halfcode-lite-cli-support": "0.2.1",
    "@types/bun": "1.4.0",
    "@types/node": "26.2.0",
    "@typescript-eslint/parser": "^8.41.0",
    "bun-types": "1.4.0",
    "eslint": "^9.34.0",
    "typescript": "^5.9.2",
    "yaml": "^2.9.0"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "license": "MIT"
}
