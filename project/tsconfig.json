{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun-types"],
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx"
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts", "e2e/**/*.ts"],
  "exclude": ["node_modules", "dist", "packages/cli/src/templates/**/*", "packages/runtime-*/bin/**/*"]
}
